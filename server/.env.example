# Port number for Express server
PORT=5000

# MongoDB Connection URI (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/zivara

# Your Firebase Project ID (found in Firebase console)
# Required for verifying client-side ID tokens in auth middleware
FIREBASE_PROJECT_ID=zivara-wear-the-future

# Optional: Replicate API token for production AI Virtual Try-On
# Get one at https://replicate.com/
REPLICATE_API_TOKEN=
